# syntax=docker/dockerfile:1
# Stock WaxFlow at the version server/go.mod pins, for `make up` only.
# Users run ghcr.io/colespringer/waxflow (the WaxFlow repo publishes it);
# compose.yaml never references this file. Build context: REPO ROOT.

FROM --platform=$BUILDPLATFORM golang:1.26-bookworm AS build
WORKDIR /src
# Both go.mods: the server module replaces the sibling fixtures module.
COPY server/go.mod server/go.sum server/
COPY fixtures/go.mod fixtures/go.sum fixtures/
ARG TARGETOS TARGETARCH
RUN --mount=type=cache,target=/go/pkg/mod \
    --mount=type=cache,target=/root/.cache/go-build \
    cd server && \
    version=$(go list -m -f '{{.Version}}' github.com/colespringer/waxflow/cli) && \
    CGO_ENABLED=0 GOOS=$TARGETOS GOARCH=$TARGETARCH go build -trimpath \
      -ldflags "-s -w -X main.version=${version}" \
      -o /out/waxflow github.com/colespringer/waxflow/cli/cmd/waxflow
RUN mkdir -p /out/state/data /out/state/cache && chown -R 10001:10001 /out/state

FROM gcr.io/distroless/static-debian12
LABEL org.opencontainers.image.source="https://github.com/ColeSpringer/WaxDeck" \
      org.opencontainers.image.description="WaxFlow at the version WaxDeck's dev stack pins" \
      org.opencontainers.image.licenses="MIT"
COPY --from=build /out/waxflow /usr/local/bin/waxflow
COPY --from=build /out/state/ /
USER 10001:10001
ENV WAXFLOW_DATA_DIR=/data \
    WAXFLOW_CACHE_DIR=/cache
EXPOSE 4418
HEALTHCHECK --interval=30s --timeout=5s --start-period=30s --start-interval=2s \
  CMD ["/usr/local/bin/waxflow", "ping"]
ENTRYPOINT ["/usr/local/bin/waxflow"]
CMD ["server"]
