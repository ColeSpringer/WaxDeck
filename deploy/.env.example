# WaxDeck settings; .env beside compose.yaml. Full list: docs/configuration.md.

# Your music and audiobook folders.
WAXDECK_MUSIC=./music
WAXDECK_AUDIOBOOKS=./audiobooks

# User the containers run as; must own the folders above (`id -u`, `id -g`).
WAXDECK_UID=1000
WAXDECK_GID=1000

# Shared secret: openssl rand -hex 24
WAXDECK_INTERNAL_KEY=
# WaxSeal's own key instead, on a host with other users (it shows in ps).
# WAXDECK_SEAL_KEY=

# Streaming engine (transcoding, gapless, voice boost). Off: 0 and an empty URL.
WAXDECK_ENGINE=1
WAXDECK_FLOW_URL=http://waxflow:4418

# Full-quality YouTube via WaxSeal (headless browser). Off: 0 and an empty URL.
WAXDECK_SEAL=1
WAXDECK_SEAL_URL=http://waxseal:4416

# Roots uploads may write into. Empty = scan-only.
WAXDECK_MANAGED_ROOTS=music,books

# Casting is on; Chromecast and DLNA devices are found automatically. Only
# where multicast cannot arrive (Docker Desktop, or the server moved off
# the host network) list devices by hand and the address they fetch from.
# WAXDECK_CAST_DISCOVERY=false
# WAXDECK_CAST_DEVICES=Kitchen speaker=192.168.1.50:8009
# WAXDECK_DLNA_DEVICES=http://192.168.1.60:8200/rootDesc.xml
# WAXDECK_ADVERTISE_BASE=http://192.168.1.20:4420

# Network mounts deliver no change events: turn the watcher off, schedule scans.
# WAXDECK_LIBRARY_WATCH=false

# true when served over HTTPS (docs/reverse-proxy.md).
WAXDECK_COOKIE_SECURE=false

# Public URL, e.g. https://wax.example.com; needed for single sign-on.
WAXDECK_PUBLIC_BASE=

# Pin a release.
# WAXDECK_TAG=v1.0.0
# WAXFLOW_TAG=v1.0.0

# Set once when release notes say the catalog baseline moved; see docs/configuration.md.
# WAXDECK_RESET_CATALOG=true
