# WaxDeck settings. `make up` creates .env from this file and generates
# the keys. Any WAXDECK_* variable set here reaches the server; the
# full list is docs/configuration.md.

# Host path of your music library.
WAXDECK_LIBRARY=./library

# User the containers run as; must be able to write the library above.
# `make up` fills these in (default: uid/gid 10001).
# WAXDECK_UID=1000
# WAXDECK_GID=1000

# Library roots uploads and downloads may write into. Empty = scan-only.
WAXDECK_MANAGED_ROOTS=lib

# Library roots are watched, so files dropped in by hand are cataloged
# within seconds. Uncomment when the library is a network mount (NFS,
# SMB) that delivers no change events, and enable the scan schedule
# instead.
# WAXDECK_LIBRARY_WATCH=false

# Internal keys (openssl rand -hex 24); `make up` generates them.
# WAXDECK_FLOW_API_KEY must be one of WAXFLOW_API_KEYS.
WAXFLOW_API_KEYS=
WAXDECK_FLOW_API_KEY=
WAXDECK_WORKER_TOKENS=

# The optional WaxSeal sidecar (--profile youtube). One key, not two:
# compose hands this same value to the daemon as its only tenant key and
# to WaxDeck as the key it sends, so the two cannot drift apart. Left
# empty the sidecar runs keyless, which is open to anything that can
# reach the internal network.
WAXDECK_SEAL_API_KEY=
# Uncomment with the youtube profile; empty means WaxDeck never contacts
# the sidecar and acquisitions stay on the key-free path.
# WAXDECK_SEAL_URL=http://waxseal:4416

# Set true when serving over HTTPS (docs/reverse-proxy.md).
WAXDECK_COOKIE_SECURE=false

# Public URL as browsers see it, e.g. https://wax.example.com.
# Needed for single sign-on.
WAXDECK_PUBLIC_BASE=

# Set once when an upgrade's release notes say the catalog baseline
# moved, then remove it. It only fires on a server that refused to
# start because its catalog was built from a different baseline; a
# healthy catalog is never touched. The old catalog is moved aside as
# a timestamped .stale-<ts>.bak rather than deleted. Left set, a
# rollback to the older version would discard the catalog the same way
# without asking - which is why it is not a permanent setting.
# WAXDECK_RESET_CATALOG=true
