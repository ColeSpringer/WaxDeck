# Copy to .env (same directory as compose.yaml) and fill in.

# Host path of your music library. WaxDeck mounts it read-write (it manages
# imports and sidecars); WaxFlow mounts the same path read-only.
WAXDECK_LIBRARY=./library

# API keys WaxFlow will accept, comma-separated. Generate each with:
#   openssl rand -hex 24
WAXFLOW_API_KEYS=

# The key WaxDeck uses to call WaxFlow. Must be (one of) the value(s) in
# WAXFLOW_API_KEYS above. With a single key, set both to the same string.
WAXDECK_FLOW_API_KEY=

# Set to true whenever the deployed origin is HTTPS (reverse proxy with
# TLS in front) so session cookies never ride cleartext.
WAXDECK_COOKIE_SECURE=false

# The externally reachable base URL of this WaxDeck, as browsers see it,
# e.g. https://wax.example.com. Required for single sign-on; harmless to
# leave empty otherwise.
WAXDECK_PUBLIC_BASE=

# Optional OIDC single sign-on. Leave WAXDECK_OIDC_ISSUER empty to
# disable; local accounts always keep working. Register the redirect URI
#   <WAXDECK_PUBLIC_BASE>/api/v1/auth/oidc/callback
# with your identity provider.
WAXDECK_OIDC_ISSUER=
WAXDECK_OIDC_ID=sso
WAXDECK_OIDC_NAME=
WAXDECK_OIDC_CLIENT_ID=
WAXDECK_OIDC_CLIENT_SECRET=
# Group-based role mapping: members of the admin group get the admin
# role on every login. Leave the claim empty to manage roles locally.
WAXDECK_OIDC_GROUPS_CLAIM=
WAXDECK_OIDC_ADMIN_GROUP=
