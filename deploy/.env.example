# Copy to .env (same directory as compose.yaml) and fill in.

# Host path of your music library. WaxDeck mounts it read-write (it manages
# imports and sidecars); WaxFlow mounts the same path read-only.
WAXDECK_LIBRARY=./library

# The user the waxdeck container runs as, so it can write into the library
# above. `make up` sets these to the user that runs it; for a bare
# `docker compose up`, set them to the owner of WAXDECK_LIBRARY (e.g. `id -u`
# / `id -g`), or leave them for the image default (10001) and make the
# library writable by that uid.
# WAXDECK_UID=1000
# WAXDECK_GID=1000

# Roots (by name) uploads and URL acquisitions may place files into.
# The compose library is WaxDeck-managed, so this defaults to "lib".
# Set it empty to keep the library strictly scan-only, or point it at a
# separate root if your main library is managed by beets or Picard.
WAXDECK_MANAGED_ROOTS=lib

# API keys WaxFlow will accept, comma-separated. Generate each with:
#   openssl rand -hex 24
WAXFLOW_API_KEYS=

# The key WaxDeck uses to call WaxFlow. Must be (one of) the value(s) in
# WAXFLOW_API_KEYS above. With a single key, set both to the same string.
WAXDECK_FLOW_API_KEY=

# Set to true whenever the deployed origin is HTTPS (reverse proxy with
# TLS in front) so session cookies never ride cleartext.
WAXDECK_COOKIE_SECURE=false

# The externally reachable base URL of this WaxDeck, as browsers see it,
# e.g. https://wax.example.com. Required for single sign-on; harmless to
# leave empty otherwise.
WAXDECK_PUBLIC_BASE=

# Optional OIDC single sign-on. Leave WAXDECK_OIDC_ISSUER empty to
# disable; local accounts always keep working. Register the redirect URI
#   <WAXDECK_PUBLIC_BASE>/api/v1/auth/oidc/callback
# with your identity provider.
WAXDECK_OIDC_ISSUER=
WAXDECK_OIDC_ID=sso
WAXDECK_OIDC_NAME=
WAXDECK_OIDC_CLIENT_ID=
WAXDECK_OIDC_CLIENT_SECRET=
# Group-based role mapping: members of the admin group get the admin
# role on every login. Leave the claim empty to manage roles locally.
WAXDECK_OIDC_GROUPS_CLAIM=
WAXDECK_OIDC_ADMIN_GROUP=

# Podcast episode retention default for subscribers who leave theirs
# unset: keep the newest N downloaded episode files per show. 0 keeps
# everything; the effective policy per show is the most generous union
# across its subscribers.
WAXDECK_PODCAST_RETENTION_DEFAULT=0

# Minutes between scheduled podcast feed refreshes.
WAXDECK_FEED_REFRESH_MINUTES=30

# Set to true when your feeds live on the LAN (a private podcast host
# on your own network); relaxes the private-address fetch guard.
WAXDECK_ALLOW_PRIVATE_FEED_HOSTS=false

# YouTube acquisition bridge, ON BY DEFAULT. Two uses: subscribe to a
# channel or playlist as a podcast (episodes land in the podcast
# library), and acquire a video, playlist, or channel into a music or
# audiobook library by URL (the library's + button, or POST
# /acquisitions). URL acquisition needs a managed root above. Set to
# false to disable the downloader entirely. Optional WaxSeal sidecar
# (compose profile "youtube", started with:
# docker compose --profile youtube up) unlocks the full-quality path;
# keys comma-separated like WAXFLOW_API_KEYS.
WAXDECK_YOUTUBE=true
WAXDECK_SEAL_URL=
WAXDECK_SEAL_API_KEY=
WAXSEAL_API_KEYS=

# Embed the source thumbnail as cover art on acquired audio, until
# enrichment finds official artwork. On by default; set to false to
# leave acquired audio without cover art.
WAXDECK_YOUTUBE_THUMBNAIL=true

# SponsorBlock categories to cut from acquired YouTube audio, comma
# separated (for example: sponsor,selfpromo). Empty disables cutting.
WAXDECK_YOUTUBE_SPONSORBLOCK=

# Casting. The advertise base is the plain-HTTP LAN URL cast devices
# fetch media from; empty auto-detects the LAN address. Static devices
# cover networks where multicast discovery never arrives.
#WAXDECK_ADVERTISE_BASE=http://192.168.1.20:4420
#WAXDECK_CAST_DISCOVERY=true
#WAXDECK_CAST_DEVICES=Kitchen speaker=192.168.1.50:8009
#WAXDECK_DLNA_DEVICES=http://192.168.1.60:8200/rootDesc.xml

# Jukebox: play out the server's own audio device as an endpoint
# (needs the streaming engine and /dev/snd).
#WAXDECK_JUKEBOX=false
#WAXDECK_JUKEBOX_NAME=Server audio
#WAXDECK_JUKEBOX_CMD=aplay -q -t wav -
