# Copy to .env (same directory as compose.yaml) and fill in.

# Host path of your music library. WaxDeck mounts it read-write (it manages
# imports and sidecars); WaxFlow mounts the same path read-only.
WAXDECK_LIBRARY=./library

# API keys WaxFlow will accept, comma-separated. Generate each with:
#   openssl rand -hex 24
WAXFLOW_API_KEYS=

# The key WaxDeck uses to call WaxFlow. Must be (one of) the value(s) in
# WAXFLOW_API_KEYS above. With a single key, set both to the same string.
WAXDECK_FLOW_API_KEY=
