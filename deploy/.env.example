# WaxDeck settings. `make up` creates .env from this file and generates
# the keys. Any WAXDECK_* variable set here reaches the server; the
# full list is docs/configuration.md.

# Host path of your music library.
WAXDECK_LIBRARY=./library

# User the containers run as; must be able to write the library above.
# `make up` fills these in (default: uid/gid 10001).
# WAXDECK_UID=1000
# WAXDECK_GID=1000

# Library roots uploads and downloads may write into. Empty = scan-only.
WAXDECK_MANAGED_ROOTS=lib

# Internal keys (openssl rand -hex 24); `make up` generates them.
# WAXDECK_FLOW_API_KEY must be one of WAXFLOW_API_KEYS.
WAXFLOW_API_KEYS=
WAXDECK_FLOW_API_KEY=
WAXDECK_WORKER_TOKENS=

# Set true when serving over HTTPS (docs/reverse-proxy.md).
WAXDECK_COOKIE_SECURE=false

# Public URL as browsers see it, e.g. https://wax.example.com.
# Needed for single sign-on.
WAXDECK_PUBLIC_BASE=
