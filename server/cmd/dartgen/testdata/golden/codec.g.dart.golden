    roles: readOptional(json, 'roles', type, (v, at) => wireList(v, at, wireString)) ?? const [],
    canDelete: readOptional(json, 'delete', type, wireBool) ?? false,
  );
}

Map<String, Object?> encodeWaxDeckUser(WaxDeckUser value) => {
  'id': value.id,
  'username': value.username,
  'displayName': ?value.displayName,
  'roles': value.roles,
  'delete': value.canDelete,
};

WsPingFrame decodeWsPingFrame(Map<String, Object?> json, WireContext ctx) {
  const type = 'WsPingFrame';
  return WsPingFrame(
    type: readRequired(json, 'type', type, wireString),
    at: readOptional(json, 'at', type, wireDateTime),
  );
}

Map<String, Object?> encodeWsPingFrame(WsPingFrame value) => {
  'type': value.type,
  if (value.at case final v?) 'at': v.toUtc().toIso8601String(),
};

bool _keepEntityCard(Object? element) =>
    element is! Map<String, Object?> || wireKnown(element['kind'], _knownEntityCardKind);

bool _keepSchedule(Object? element) =>
    element is! Map<String, Object?> || wireKnown(element['kind'], _knownScheduleKind);

const _knownEnrichmentPhase = {'identity', 'releases', 'lyrics'};

const _knownEntityCardKind = {'album', 'artist', 'release-group', 'playlist'};

const _knownEpisodeSummaryFetchState = {'queued', 'failed'};

const _knownScheduleKind = {'scan', 'backup', 'prune'};

const _knownShelfWant = {'albums', 'artists', 'books'};
