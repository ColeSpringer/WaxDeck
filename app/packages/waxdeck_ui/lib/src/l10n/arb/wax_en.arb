  "playerSkipForwardSeconds": "{seconds, plural, =1{Forward 1 second} other{Forward {seconds} seconds}}",
  "@playerSkipForwardSeconds": {
    "description": "Button in the full player that jumps forwards in spoken-word playback by a fixed number of seconds.",
    "placeholders": {
      "seconds": {
        "type": "int",
        "example": "30"
      }
    }
  },
  "scaffoldBack": "Back",
  "@scaffoldBack": {
    "description": "Accessible name of a screen's back button."
  },
  "settingsChoiceValue": "{label}, {value}",
