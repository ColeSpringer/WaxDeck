      "label": {
        "type": "String",
        "example": "Open search"
      },
      "keys": {
        "type": "String",
        "example": "Ctrl K"
      }
    }
  },
  "paletteShortcutsTitle": "Keyboard shortcuts",
  "@paletteShortcutsTitle": {
    "description": "Title of the sheet listing every keyboard shortcut."
  },
  "panelClose": "Close panel",
  "@panelClose": {
    "description": "Accessible name of the close button on a side panel."
  },
  "percentOf": "{percent}%",
  "@percentOf": {
    "description": "A proportion, as a screen reader hears it from a slider or a splitter. Some languages put a space before the sign.",
    "placeholders": {
      "percent": {
        "type": "int",
        "example": "25"
      }
    }
  },
  "playerCollapse": "Collapse player",
  "@playerCollapse": {
    "description": "Button that closes the full-window player and leaves the bar behind."
