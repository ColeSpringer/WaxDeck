        "example": "Name"
      }
    }
  },
  "inputsSearchHint": "Search",
  "@inputsSearchHint": {
    "description": "Placeholder text inside an empty search field."
  },
  "inputsSearchLabel": "Search",
  "@inputsSearchLabel": {
    "description": "Accessible name of a search field."
  },
  "lyricsFollowAlong": "Follow along",
