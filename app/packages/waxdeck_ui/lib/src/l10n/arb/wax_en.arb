      "section": {
        "type": "String",
        "example": "Library"
      }
    }
  },
  "navExpandSidebar": "Expand sidebar",
  "@navExpandSidebar": {
    "description": "Button that widens the narrowed sidebar back to labelled rows."
  },
  "navMain": "Main navigation",
  "@navMain": {
    "description": "Accessible name of the window's navigation chrome, taken as a whole."
  },
  "navSkipToContent": "Skip to content",
  "@navSkipToContent": {
    "description": "The first thing a keyboard reaches on the page: a link that jumps past the navigation to what the page is about."
  },
  "paletteClose": "Close",
  "@paletteClose": {
    "description": "Accessible name of the close button on the keyboard shortcut sheet."
  },
  "paletteEmptyMessage": "Try fewer words, or a different one.",
  "@paletteEmptyMessage": {
    "description": "What the command palette suggests when a query matches nothing."
