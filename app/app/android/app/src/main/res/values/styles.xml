<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- The window while the process starts, with the OS in light mode. -->
    <style name="LaunchTheme" parent="@android:style/Theme.Light.NoTitleBar">
        <item name="android:windowBackground">@drawable/launch_background</item>
    </style>
    <!-- The window from process start onwards, and behind the Flutter UI
         while it initialises: the canvas colour, so no frame of the app's
         life is a different colour from the app. -->
    <style name="NormalTheme" parent="@android:style/Theme.Light.NoTitleBar">
        <item name="android:windowBackground">@color/wax_canvas</item>
    </style>
</resources>
