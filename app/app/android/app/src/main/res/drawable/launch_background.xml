<?xml version="1.0" encoding="utf-8"?>
<!-- The launch window, light. It holds the canvas colour and the mark so
     the app does not flash white before Flutter's first frame. Android 12
     and up uses the splash theme in values-v31 instead. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:drawable="@color/wax_canvas" />
    <item>
        <bitmap
            android:gravity="center"
            android:src="@mipmap/splash_icon" />
    </item>
</layer-list>
