{
  "@@locale": "en",
  "@@x-template": "en.arb",
  "downloadsCancel": "Cancel {title}",
  "@downloadsCancel": {
    "description": "Accessible name of the control that stops one transfer. {title} is what is being downloaded.",
    "placeholders": {
      "title": {
        "type": "String",
        "example": "Long Exposure"
      }
    }
  },
  "downloadsChecking": "Checking downloads against the server",
  "@downloadsChecking": {
    "description": "Snackbar while the re-download sweep runs."
  },
  "downloadsChip": "{medium} {size}",
  "@downloadsChip": {
    "description": "How much one medium takes up: what it is, then how much. {size} is a formatted size.",
    "placeholders": {
      "medium": {
        "type": "String",
        "example": "Music"
      },
      "size": {
        "type": "String",
        "example": "640 MB"
      }
    }
  },
  "downloadsClearAll": "Clear all",
  "@downloadsClearAll": {
    "description": "Removes every download from this device."
  },
  "downloadsClearBody": "This frees {size}. Nothing leaves the library: everything here plays again with the server reachable.",
  "@downloadsClearBody": {
    "description": "Body of the clear-downloads dialog. {size} is a formatted size.",
    "placeholders": {
      "size": {
        "type": "String",
        "example": "1.5 GB"
      }
    }
  },
  "downloadsClearConfirm": "Remove all",
  "@downloadsClearConfirm": {
    "description": "Confirming button of the clear-downloads dialog."
  },
  "downloadsClearKeep": "Keep them",
  "@downloadsClearKeep": {
    "description": "Dismissing button of the clear-downloads dialog."
  },
  "downloadsClearTitle": "Remove every download?",
  "@downloadsClearTitle": {
    "description": "Title of the dialog confirming that every download goes."
  },
  "downloadsDownloaded": "Downloaded",
  "@downloadsDownloaded": {
    "description": "Accessible name of the download control once the file is on this device."
  },
  "downloadsDownloading": "Downloading",
  "@downloadsDownloading": {
    "description": "Accessible name of the download control while the transfer is running."
  },
  "downloadsEmptyMessage": "Download a book, an album, or an episode and it plays here with the server unreachable. Its cover comes with it.",
  "@downloadsEmptyMessage": {
    "description": "Empty state of the downloads screen."
  },
  "downloadsEmptyTitle": "Nothing downloaded",
  "@downloadsEmptyTitle": {
    "description": "Empty state of the downloads screen."
  },
  "downloadsGroupItems": "{count, plural, =1{1 item} other{{count} items}}",
  "@downloadsGroupItems": {
    "description": "Overline over one medium's downloads, saying how many.",
    "placeholders": {
      "count": {
        "type": "int",
        "example": "12"
      }
    }
  },
  "downloadsInFlight": "{count, plural, =1{1 in flight} other{{count} in flight}}",
  "@downloadsInFlight": {
    "description": "Overline over the running downloads, saying how many.",
    "placeholders": {
      "count": {
        "type": "int",
        "example": "3"
      }
    }
  },
  "downloadsLoadError": "Could not read your downloads",
  "@downloadsLoadError": {
    "description": "Title of the error state when the on-device download store would not answer."
  },
  "downloadsMediumBooks": "Audiobooks",
  "@downloadsMediumBooks": {
    "description": "What a group of downloaded audiobooks is called."
  },
  "downloadsMediumMusic": "Music",
  "@downloadsMediumMusic": {
    "description": "What a group of downloaded music is called."
  },
  "downloadsMediumPodcasts": "Podcasts",
  "@downloadsMediumPodcasts": {
    "description": "What a group of downloaded episodes is called."
  },
  "downloadsNoneFinished": "No finished episodes to remove",
  "@downloadsNoneFinished": {
    "description": "Snackbar when the remove-finished sweep found nothing."
  },
  "downloadsNoticeAskAllow": "Allow",
  "@downloadsNoticeAskAllow": {
    "description": "Button in the dialog about download notifications that goes on to the system's own permission prompt."
  },
  "downloadsNoticeAskBody": "A download reports its progress in a notification, and Android asks before an app may post one.",
  "@downloadsNoticeAskBody": {
    "description": "Body of the dialog shown before the system asks a second time whether downloads may post notifications."
  },
  "downloadsNoticeAskLater": "Not now",
  "@downloadsNoticeAskLater": {
    "description": "Button that closes the dialog about download notifications without asking the system."
  },
  "downloadsNoticeAskTitle": "Show download progress?",
  "@downloadsNoticeAskTitle": {
    "description": "Title of the dialog shown before the system asks a second time whether downloads may post notifications."
  },
  "downloadsNoticeDone": "Downloaded",
  "@downloadsNoticeDone": {
    "description": "Body of a download's system notification once the item is on this device."
  },
  "downloadsNoticeFailed": "Download failed",
  "@downloadsNoticeFailed": {
    "description": "Body of a download's system notification when it could not finish."
  },
  "downloadsNoticePart": "{title} ({number} of {total})",
  "@downloadsNoticePart": {
    "description": "Title of the system notification for one file of an item of several, such as one part of an audiobook.",
    "placeholders": {
      "title": {
        "type": "String",
        "example": "The Hobbit"
      },
      "number": {
        "type": "int",
        "example": "3"
      },
      "total": {
        "type": "int",
        "example": "20"
      }
    }
  },
  "downloadsNoticeRunning": "Downloading {progress}",
  "@downloadsNoticeRunning": {
    "description": "Body of a download's system notification while it runs. The system fills in {progress} with the percentage done.",
    "placeholders": {
      "progress": {
        "type": "String",
        "example": "40%"
      }
    }
  },
  "downloadsOverflow": "More",
  "@downloadsOverflow": {
    "description": "Tooltip of the menu holding the sweeps that act on every download."
  },
  "downloadsPause": "Pause {title}",
  "@downloadsPause": {
    "description": "Accessible name of the control that parks one transfer.",
    "placeholders": {
      "title": {
        "type": "String",
        "example": "Long Exposure"
      }
    }
  },
  "downloadsRefreshStale": "Re-download stale",
  "@downloadsRefreshStale": {
    "description": "Menu row checking every download against the server and fetching what changed."
  },
  "downloadsRemove": "Remove {title}",
  "@downloadsRemove": {
    "description": "Accessible name of the control that deletes one download from this device.",
    "placeholders": {
      "title": {
        "type": "String",
        "example": "Long Exposure"
      }
    }
  },
  "downloadsRemoveFinished": "Remove finished episodes",
  "@downloadsRemoveFinished": {
    "description": "Menu row deleting every downloaded episode that was played to the end."
  },
  "downloadsRemovedEpisodes": "{count, plural, =1{Removed 1 episode} other{Removed {count} episodes}}",
  "@downloadsRemovedEpisodes": {
    "description": "Snackbar after the remove-finished sweep.",
    "placeholders": {
      "count": {
        "type": "int",
        "example": "4"
      }
    }
  },
  "downloadsResume": "Resume {title}",
  "@downloadsResume": {
    "description": "Accessible name of the control that restarts one paused transfer.",
    "placeholders": {
      "title": {
        "type": "String",
        "example": "Long Exposure"
      }
    }
  },
  "downloadsTitle": "Downloads",
  "@downloadsTitle": {
    "description": "Title of the screen managing what this device keeps offline."
  },
  "downloadsTransferring": "Transferring",
  "@downloadsTransferring": {
    "description": "Heading over the downloads running right now."
  }
}
