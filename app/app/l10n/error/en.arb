  },
  "errorNotFound": "That is not here any more.",
  "@errorNotFound": {
    "description": "Error sentence for the spec code `not-found`."
  },
  "errorQuotaExceeded": "That would go over the storage limit.",
  "@errorQuotaExceeded": {
    "description": "Error sentence for the spec code `quota-exceeded`."
  },
  "errorRateLimited": "Too many attempts. Wait a moment and try again.",
  "@errorRateLimited": {
    "description": "Error sentence for the spec code `rate-limited`."
  },
  "errorReadOnly": "The library is read-only right now, so nothing can be changed.",
  "@errorReadOnly": {
    "description": "Error sentence for the spec code `read-only`: reads and playback keep working."
  },
  "errorServiceUnreachable": "An outside service this needs did not answer. Try again later.",
  "@errorServiceUnreachable": {
    "description": "Error sentence for the spec code `service-unreachable`, such as a scrobbling provider."
  },
  "errorSourceUnavailable": "This server is not running the source that request needs.",
  "@errorSourceUnavailable": {
    "description": "Error sentence for the spec code `source-unavailable`: an acquisition integration this server does not run."
  },
  "errorStreamStale": "This file changed on the server. Open it again to play it.",
