{
  "@@locale": "en",
  "@@x-template": "en.arb",
  "errorBookToolCopyElsewhere": "This book has a copy at {copy}, which would be left as the book. Delete the copy, or keep the originals.",
  "@errorBookToolCopyElsewhere": {
    "description": "Error sentence for a book merge or split refused with `conflict` and the params' reason copy-elsewhere, when the copy's library has no name to give.",
    "placeholders": {
      "copy": {
        "type": "String",
        "example": "Ada Author/The Book/part 1.m4b"
      }
    }
  },
  "errorBookToolCopyElsewhereIn": "This book has a copy at {copy} in the {library} library, which would be left as the book. Delete the copy, or keep the originals.",
  "@errorBookToolCopyElsewhereIn": {
    "description": "Error sentence for a book merge or split refused with `conflict` and the params' reason copy-elsewhere: the copy's place and its library.",
    "placeholders": {
      "copy": {
        "type": "String",
        "example": "Ada Author/The Book/part 1.m4b"
      },
      "library": {
        "type": "String",
        "example": "Audiobooks"
      }
    }
  },
  "errorBookToolMultiFile": "This book is already split into several files. Merge it first to split it again.",
  "@errorBookToolMultiFile": {
    "description": "Error sentence for a book split refused with `conflict` and the params' reason multi-file."
  },
  "errorBookToolNameTaken": "{name} is already in {folder}. Move it away, then try again.",
  "@errorBookToolNameTaken": {
    "description": "Error sentence for a book merge or split refused with `conflict` and the params' reason name-taken: a file already holds the name the new file would take.",
    "placeholders": {
      "name": {
        "type": "String",
        "example": "The Book (Merged).m4b"
      },
      "folder": {
        "type": "String",
        "example": "Ada Author/The Book (Merged)"
      }
    }
  },
  "errorBookToolNoChapters": "This book has no chapters to split at.",
  "@errorBookToolNoChapters": {
    "description": "Error sentence for a book split refused with `conflict` and the params' reason no-chapters."
  },
  "errorBookToolNoCuts": "This book's chapter marks leave nowhere to cut it.",
  "@errorBookToolNoCuts": {
    "description": "Error sentence for a book split refused with `conflict` and the params' reason no-cuts: every chapter mark falls at the start, or on another."
  },
  "errorBookToolNoFile": "This book has no file to split.",
  "@errorBookToolNoFile": {
    "description": "Error sentence for a book split refused with `conflict` and the params' reason no-file."
  },
  "errorBookToolNoSampleRate": "This book's file does not say its sample rate, so its chapters cannot be cut exactly.",
  "@errorBookToolNoSampleRate": {
    "description": "Error sentence for a book split refused with `conflict` and the params' reason no-sample-rate."
  },
  "errorBookToolPartsInTrash": "{count, plural, =1{1 of this book's files went} other{{count} of this book's files went}} to the trash with a merge or split that did not finish: {files}{more, plural, =0{} other{, and {more} more}}. Restore {count, plural, =1{it} other{them}} from the trash, then merge or split the book again.",
  "@errorBookToolPartsInTrash": {
    "description": "A merge or split refused because an earlier one that did not finish left some of the book's files in the trash, which none of its new files holds: a merge of what remains would leave them out. {files} names the first few by their place in their library, and {more} counts the rest (zero when all are named).",
    "placeholders": {
      "count": {
        "type": "int",
        "example": "60"
      },
      "files": {
        "type": "String",
        "example": "Ada/Book/part 1.m4b, Ada/Book/part 2.m4b"
      },
      "more": {
        "type": "int",
        "example": "55"
      }
    }
  },
  "errorBookToolSingleFile": "This book is already one file, so there is nothing to merge.",
  "@errorBookToolSingleFile": {
    "description": "Error sentence for a book merge refused with `conflict` and the params' reason single-file: the book is one file already."
  },
  "errorCatalogBusy": "Another job is holding the library's files. Try again shortly.",
  "@errorCatalogBusy": {
    "description": "Error sentence for the spec code `catalog-busy`: a file-moving request cannot start yet, and this one clears on its own."
  },
  "errorCatalogMaintenance": "The library is busy with maintenance. Try again shortly.",
  "@errorCatalogMaintenance": {
    "description": "Error sentence for the spec code `catalog-maintenance`."
  },
  "errorConflict": "Something else changed this first. Take another look and try again.",
  "@errorConflict": {
    "description": "Error sentence for the spec code `conflict`: the state moved under the request."
  },
  "errorCueRipDelete": "This track is part of a larger file that holds other tracks too, so it can only be deleted together with them.",
  "@errorCueRipDelete": {
    "description": "Error sentence for `invalid-request` when the params' reason is cue-rip: a delete named one of the tracks a cue sheet cuts from one file, without the rest."
  },
  "errorCueSplitNoSheet": "The file this track is cut from has no CUE sheet of its own name beside it, so there is nothing to split it by.",
  "@errorCueSplitNoSheet": {
    "description": "Error sentence for a CUE split refused with `conflict` and the params' reason no-sheet: the album file has no .cue of the same name next to it. CUE is the sheet format's name, so it keeps its capitals."
  },
  "errorDirectoryUnavailable": "The directory service did not answer. Try again later.",
  "@errorDirectoryUnavailable": {
    "description": "Error sentence for the spec code `directory-unavailable`, such as the radio station directory."
  },
  "errorDrmProtected": "Audible DRM files can't be played.",
  "@errorDrmProtected": {
    "description": "Error sentence for the spec code `drm-protected`: an encrypted container (Audible aax/aaxc) was refused. Permanent, unlike `unsupported-format` - no server setting makes the file playable - and the sentence says so instead of implying a codec gap."
  },
  "errorEndpointBusy": "That device is in the middle of something else. Stop it there and try again.",
  "@errorEndpointBusy": {
    "description": "Error sentence for `endpoint-busy`: the target device is playing something the request would have taken it over from."
  },
  "errorEndpointFailed": "That device could not carry that out. It is still connected, so it is worth trying again.",
  "@errorEndpointFailed": {
    "description": "Error sentence for the spec code `endpoint-failed`: the other device took the command and failed at it, unlike `endpoint-offline`, where it never got it."
  },
  "errorEndpointOffline": "That device is not connected. Refresh the list of devices.",
  "@errorEndpointOffline": {
    "description": "Error sentence for the spec code `endpoint-offline`."
  },
  "errorFeatureUnavailable": "This server is not running the feature that request needs.",
  "@errorFeatureUnavailable": {
    "description": "Error sentence for the spec code `feature-unavailable` where nothing more specific is known about which capability is missing."
  },
  "errorFeedBlockedAddress": "This server does not fetch from private or local network addresses.",
  "@errorFeedBlockedAddress": {
    "description": "Error sentence for the reason blocked-address, under `invalid-request` (a subscribe the table words) or `feed-unreachable` (a refresh or a transcript): a feed, or a transcript a feed points at, sits on a private or local network, which this server does not fetch from."
  },
  "errorFeedHostError": "The host answered with an error. Try again later.",
  "@errorFeedHostError": {
    "description": "Error sentence for `feed-unreachable` with the reason host-error: the host of a feed or of its transcript answered a server error or asked to be tried later, which can pass on its own."
  },
  "errorFeedNotAFeed": "That address answered, but not with anything a podcast app can read.",
  "@errorFeedNotAFeed": {
    "description": "Error sentence for the reason not-a-feed, under `invalid-request` (a subscribe the table words, such as from a directory match) or `feed-unreachable` (a refresh or a transcript): the address returned something that is not a feed or a transcript."
  },
  "errorFeedNotFound": "The host has nothing at that address.",
  "@errorFeedNotFound": {
    "description": "Error sentence for `feed-unreachable` with the reason host-missing: the host of a feed or of its transcript answered that nothing is there (404 or 410)."
  },
  "errorFeedRefused": "The host refused the request. It may need a login.",
  "@errorFeedRefused": {
    "description": "Error sentence for `feed-unreachable` with the reason host-refused: the host of a feed or of its transcript refused the request (401, 403 and the like), which can mean the feed wants credentials."
  },
  "errorFeedTooLarge": "What that address sent back is larger than this server accepts.",
  "@errorFeedTooLarge": {
    "description": "Error sentence for the reason too-large, under `invalid-request` or `feed-unreachable`: the feed or transcript is over this server's size cap. It names no size, since feeds and transcripts have different caps."
  },
  "errorFeedUnreachable": "The feed's own server did not answer, or did not answer with a feed.",
  "@errorFeedUnreachable": {
    "description": "Error sentence for the spec code `feed-unreachable`, and for the reasons under it this client has no sentence of its own for, a host out of reach among them."
  },
  "errorFieldLocked": "That field is locked. Unlock it, or save with the override.",
  "@errorFieldLocked": {
    "description": "Error sentence for the spec code `field-locked`."
  },
  "errorForbidden": "Your account is not allowed to do that.",
  "@errorForbidden": {
    "description": "Error sentence for the spec code `forbidden`: signed in, but without the permission."
  },
  "errorIncompatibleBackup": "This backup was made by a WaxDeck version whose databases this server can't open. Restore it with the version that made it.",
  "@errorIncompatibleBackup": {
    "description": "Error sentence for `invalid-request` when the params' reason is incompatible-schema: staging a restore from a backup another schema made."
  },
  "errorInternal": "The server ran into a problem it could not handle.",
  "@errorInternal": {
    "description": "Error sentence for the spec code `internal`."
  },
  "errorInvalidRequest": "That request was not something the server could act on.",
  "@errorInvalidRequest": {
    "description": "Error sentence for the spec code `invalid-request`."
  },
  "errorLocalChannelOffline": "WaxDeck lost its live connection to the server. It reconnects on its own; try again in a moment.",
  "@errorLocalChannelOffline": {
    "description": "Error sentence for the client's own `local-channel-offline` code: the event socket this device controls playback over is down. Nothing outside WaxDeck failed."
  },
  "errorLocalCommandTimeout": "The server did not answer that command in time. Try again.",
  "@errorLocalCommandTimeout": {
    "description": "Error sentence for the client's own `local-command-timeout` code: a command sent over the event socket ran past this device's deadline."
  },
  "errorLocalUnregistered": "This device is not set up as a player yet. Try again in a moment.",
  "@errorLocalUnregistered": {
    "description": "Error sentence for the client's own `local-unregistered` code: playback was asked to move here before this device finished announcing itself as a player."
  },
  "errorNetwork": "Could not reach the server. Check the connection and try again.",
  "@errorNetwork": {
    "description": "Error sentence for the client's own `transport` code: the request never reached a server that could answer it."
  },
  "errorNotFound": "That is not here any more.",
  "@errorNotFound": {
    "description": "Error sentence for the spec code `not-found`."
  },
  "errorPodcastsOff": "Podcasts are turned off on this server.",
  "@errorPodcastsOff": {
    "description": "Error sentence for `feature-unavailable` when the params name the feature as podcasts: a subscribe or an OPML import on a server run with its podcast directory turned off."
  },
  "errorQuotaExceeded": "That is over a limit this server keeps.",
  "@errorQuotaExceeded": {
    "description": "Error sentence for the spec code `quota-exceeded`. The code is shared by an upload over the uploader's allowance, a backup import and an account export, so it names no particular limit."
  },
  "errorRateLimited": "Too many attempts. Wait a moment and try again.",
  "@errorRateLimited": {
    "description": "Error sentence for the spec code `rate-limited`."
  },
  "errorReadOnly": "The server or this library is read-only right now, so nothing can be changed.",
  "@errorReadOnly": {
    "description": "Error sentence for the spec code `read-only`: reads and playback keep working."
  },
  "errorServiceUnreachable": "An outside service this needs did not answer. Try again later.",
  "@errorServiceUnreachable": {
    "description": "Error sentence for the spec code `service-unreachable`, such as a scrobbling provider."
  },
  "errorSourceUnavailable": "This server is not running the source that request needs.",
  "@errorSourceUnavailable": {
    "description": "Error sentence for the spec code `source-unavailable`: an acquisition integration this server does not run."
  },
  "errorStorageFull": "The server has no room for this right now. Ask whoever runs it.",
  "@errorStorageFull": {
    "description": "Error sentence for the spec code `storage-full`: the server's own disk, not the reader's allowance, so there is nothing they can clear."
  },
  "errorStorageUnwritable": "The server cannot write to that library's folder, so nothing was changed. Check the folder's ownership and permissions.",
  "@errorStorageUnwritable": {
    "description": "Error sentence for the spec code `storage-unwritable`: a library folder refused the server's write, for its permissions or a read-only mount, so nothing changed."
  },
  "errorStreamStale": "This file changed on the server. Open it again to play it.",
  "@errorStreamStale": {
    "description": "Error sentence for the spec code `stream-stale`: a minted media URL no longer matches the file it points at."
  },
  "errorStreamingEngine": "The streaming engine is not reachable right now. Originals still play; transcoding, gapless playback, voice boost and merging or splitting files wait for it.",
  "@errorStreamingEngine": {
    "description": "Error sentence for `feature-unavailable` when the params name the feature streaming-engine: a request only the streaming engine serves (a queue rendered as one stream, a stream with voice boost, a format or a bitrate, a book merge or split, a CUE split) while the server cannot reach its engine. Temporary: the server retries the engine in the background."
  },
  "errorSyncReset": "This device is too far behind to catch up, so it will sync again from scratch.",
  "@errorSyncReset": {
    "description": "Error sentence for the spec code `sync-reset`: the local copy predates the change history the server kept."
  },
  "errorTimeout": "The device did not answer in time. Try again.",
  "@errorTimeout": {
    "description": "Error sentence for the spec code `timeout`: a command sent to a player that is still connected but did not reply."
  },
  "errorToolOutputsHidden": "This task's new files in {folder} could not be named or removed ({cause}), so the task stays. Fix the folder, then clear it again.",
  "@errorToolOutputsHidden": {
    "description": "Clearing a finished book merge or split was refused: its new files, still hidden, could not take their names or be removed in their folder, so the task stays (holding its book) until they can. {cause} is the system's reason, as the server gives it.",
    "placeholders": {
      "folder": {
        "type": "String",
        "example": "Ada/Book"
      },
      "cause": {
        "type": "String",
        "example": "permission denied"
      }
    }
  },
  "errorToolTaskParked": "An earlier merge or split of this stopped and needs attention. Clear it in Tasks, then try again.",
  "@errorToolTaskParked": {
    "description": "Error sentence for a file tool refused with `conflict` and the params' reason task-parked: an earlier merge or split of the same book, or split of the same rip, stopped part way and is parked, holding it until it is cleared in Tasks. Waiting does not help."
  },
  "errorToolTaskRunning": "A merge or split of this is still at work. Try again once it has finished.",
  "@errorToolTaskRunning": {
    "description": "Error sentence for a file tool refused with `conflict` and the params' reason task-running: another merge or split of the same book, or split of the same rip, has not finished."
  },
  "errorTranscodeLimited": "Too many streams are being converted at once. Try again in a moment.",
  "@errorTranscodeLimited": {
    "description": "Error sentence for the spec code `transcode-limited`."
  },
  "errorTransportEmpty": "The server's answer arrived empty.",
  "@errorTransportEmpty": {
    "description": "Error sentence for the client's own `transport-empty` code: an answer arrived with no body in it."
  },
  "errorTransportTimeout": "The server did not answer in time.",
  "@errorTransportTimeout": {
    "description": "Error sentence for the client's own `transport-timeout` code: the connection itself ran out of time."
  },
  "errorUnauthenticated": "Sign in again to carry on.",
  "@errorUnauthenticated": {
    "description": "Error sentence for the spec code `unauthenticated`: the session is gone, or was never there."
  },
  "errorUnexpected": "Something went wrong.",
  "@errorUnexpected": {
    "description": "What an error surface shows when nothing more specific is known."
  },
  "errorUnreadableFile": "That file could not be read as audio. It may be damaged, or not audio at all.",
  "@errorUnreadableFile": {
    "description": "A completed upload whose bytes do not read as audio (the server's `unsupported-format` with reason `unreadable`). Its session is already gone, so the person sends the file again."
  },
  "errorUnsupportedFormat": "This server does not accept that file's format.",
  "@errorUnsupportedFormat": {
    "description": "Error sentence for the spec code `unsupported-format`."
  },
  "errorWindowedTrack": "This track is part of a larger file, which another device can't play yet. Play it on this one instead.",
  "@errorWindowedTrack": {
    "description": "Error sentence for `feature-unavailable` when the params name the feature as windowed-track."
  }
}
