    "description": "Error sentence for the spec code `conflict`: the state moved under the request."
  },
  "errorDirectoryUnavailable": "The directory service did not answer. Try again later.",
  "@errorDirectoryUnavailable": {
    "description": "Error sentence for the spec code `directory-unavailable`, such as the radio station directory."
  },
  "errorEndpointOffline": "That device is not connected. Refresh the list of devices.",
  "@errorEndpointOffline": {
    "description": "Error sentence for the spec code `endpoint-offline`."
  },
  "errorFeatureUnavailable": "This server is not running the feature that request needs.",
