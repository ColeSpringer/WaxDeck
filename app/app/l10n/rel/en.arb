{
  "@@locale": "en",
  "@@x-template": "en.arb",
  "relDaysAgo": "{days, plural, =1{1 d ago} other{{days} d ago}}",
  "@relDaysAgo": {
    "description": "How long ago something happened, in days, on a dashboard tile with room for a few words.",
    "placeholders": {
      "days": {
        "type": "int",
        "example": "3"
      }
    }
  },
  "relDaysShort": "{days, plural, =1{1d ago} other{{days}d ago}}",
  "@relDaysShort": {
    "description": "How long ago something happened, in days, in the audit log's own column - abbreviated hard, because a reader scans a page of these rather than reading one.",
    "placeholders": {
      "days": {
        "type": "int",
        "example": "3"
      }
    }
  },
  "relDueNow": "due now",
  "@relDueNow": {
    "description": "What a scheduled job's next-run caption says once that time has passed and the run has not started yet."
  },
  "relHoursAgo": "{hours, plural, =1{1 h ago} other{{hours} h ago}}",
