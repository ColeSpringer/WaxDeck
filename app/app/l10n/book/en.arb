    "description": "Button picking a book up where it was left, on a book whose chapters the resume point could not name."
  },
  "bookResumeChapter": "Resume {chapter}",
  "@bookResumeChapter": {
    "description": "The same button naming the chapter the listener stopped in, which is what makes it a promise rather than a guess.",
    "placeholders": {
      "chapter": {
        "type": "String",
        "example": "Chapter 12"
      }
    }
  },
  "bookSeriesSequence": "Book {number} of {series}",
  "@bookSeriesSequence": {
    "description": "Where a book sits in its series, as a link to the rest of it.",
    "placeholders": {
      "number": {
        "type": "String",
        "example": "2"
      },
      "series": {
        "type": "String",
        "example": "Earthsea"
      }
    }
  },
  "bookSettingsSpeed": "Speed {speed}",
  "@bookSettingsSpeed": {
    "description": "The playback rate this book is set to. {speed} arrives already worded, with its multiplier sign.",
    "placeholders": {
      "speed": {
        "type": "String",
        "example": "1.2x"
      }
    }
  },
  "bookSettingsSpeedLabel": "Playback speed",
  "@bookSettingsSpeedLabel": {
    "description": "Accessible name of the speed slider on the per-book settings sheet."
  },
  "bookShareLink": "Share link",
  "@bookShareLink": {
    "description": "Row in a book's overflow minting a link somebody outside the server can open."
  },
  "bookSplit": "Split at chapters",
  "@bookSplit": {
    "description": "Row in a book's overflow cutting one file into a file per chapter. Administrators only."
  },
  "bookStartOver": "Start over",
  "@bookStartOver": {
    "description": "Row in a book's overflow putting the listener back at the beginning."
  },
  "bookToolQueued": "Queued. Follow it in Tasks.",
  "@bookToolQueued": {
    "description": "Snackbar after starting a merge or a split, which run as background tasks. The capitalised word is the name of the screen that lists them."
  },
  "bookToolTasks": "Tasks",
  "@bookToolTasks": {
    "description": "Action on the queued-tool snackbar, opening the screen that lists background tasks."
  },
  "bookTrimSilence": "Trim silence",
  "@bookTrimSilence": {
    "description": "Switch shortening the gaps in a book's narration."
  },
  "bookTrimSilenceHelp": "Shortens the pauses between sentences",
  "@bookTrimSilenceHelp": {
    "description": "Help under the trim-silence switch on a book."
  },
  "bookUndo": "Undo",
  "@bookUndo": {
    "description": "Action on the position snackbars, putting back where the listener was."
  },
  "bookVoiceBoost": "Voice boost",
  "@bookVoiceBoost": {
    "description": "Switch lifting the narrator above the rest of the audio."
  },
  "bookVoiceBoostHelp": "Lifts speech over a noisy room",
  "@bookVoiceBoostHelp": {
    "description": "Help under the voice-boost switch on a book."
  },
  "bookYes": "Yes",
  "@bookYes": {
    "description": "The value of a yes-or-no row in a book's edition details."
  },
  "booksAuthorChip": "{name} ({count})",
  "@booksAuthorChip": {
    "description": "Chip narrowing the hub to one author, with how many books they have on the shelf.",
    "placeholders": {
      "name": {
        "type": "String",
        "example": "Ursula K. Le Guin"
      },
      "count": {
        "type": "int"
      }
    }
  },
  "booksContinueOverline": "Part way through",
  "@booksContinueOverline": {
    "description": "Overline above the continue-listening shelf."
  },
  "booksContinueTitle": "Continue listening",
  "@booksContinueTitle": {
    "description": "Shelf on the audiobook hub holding the books part way through."
  },
