  "@bookPartsCount": {
    "description": "How many files a book is, in the line under its title. Only said where there is more than one.",
    "placeholders": {
      "count": {
        "type": "int"
      }
    }
  },
  "bookPartsNote": "{count, plural, other{This book is {count} files, played as one timeline. Positions and chapters span all of them.}}",
  "@bookPartsNote": {
    "description": "Footnote on a book made of several files, so a listener who wonders why has the answer where they are looking.",
    "placeholders": {
      "count": {
        "type": "int"
      }
    }
  },
  "bookPercent": "{percent} percent",
  "@bookPercent": {
    "description": "How far through a book the listener is, in the line under its title.",
    "placeholders": {
      "percent": {
        "type": "int"
      }
    }
  },
