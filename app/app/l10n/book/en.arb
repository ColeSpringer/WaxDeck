{
  "@@locale": "en",
  "@@x-template": "en.arb",
  "bookBackToBeginning": "Back to the beginning",
  "@bookBackToBeginning": {
    "description": "Snackbar after putting a book's position back at zero."
  },
  "bookByAuthors": "By {names}",
  "@bookByAuthors": {
    "description": "Who wrote a book, under its title. {names} is the authors joined by commas.",
    "placeholders": {
      "names": {
        "type": "String",
        "example": "Ursula K. Le Guin"
      }
    }
  },
  "bookChapterFallback": "Chapter {number}",
  "@bookChapterFallback": {
    "description": "Stands in for a chapter mark the file numbered but did not title.",
    "placeholders": {
      "number": {
        "type": "int"
      }
    }
  },
  "bookChaptersOverline": "{count, plural, =1{1 in this book} other{{count} in this book}}",
  "@bookChaptersOverline": {
    "description": "Overline above a book's chapters, counting them.",
    "placeholders": {
      "count": {
        "type": "int"
      }
    }
  },
  "bookChaptersTitle": "Chapters",
  "@bookChaptersTitle": {
    "description": "Heading over a book's chapter list."
  },
  "bookDownloadOffline": "Download for offline",
  "@bookDownloadOffline": {
    "description": "Control keeping a book's audio on this device."
  },
  "bookEditMetadata": "Edit metadata",
  "@bookEditMetadata": {
    "description": "Row in a book's overflow opening the metadata editor. Administrators only."
  },
  "bookEditionTitle": "About this edition",
