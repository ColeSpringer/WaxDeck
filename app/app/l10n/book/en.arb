    "description": "Message under the empty state of the audiobook hub."
  },
  "booksEmptyTitle": "No audiobooks yet",
  "@booksEmptyTitle": {
    "description": "Empty state of the audiobook hub."
  },
  "booksFilterAll": "All",
  "@booksFilterAll": {
    "description": "Chip showing every book."
  },
  "booksFilterEmptyMessage": "{filter, select, unfinished{No book here is unfinished.} finished{No book here is finished.} other{No book here matches.}}",
  "@booksFilterEmptyMessage": {
    "description": "Why the book grid came up empty, named after the chip that narrowed it.",
    "placeholders": {
      "filter": {
        "type": "String",
        "example": "finished"
      }
    }
  },
  "booksFilterFinished": "Finished",
  "@booksFilterFinished": {
    "description": "Chip narrowing the hub to the books listened to the end."
  },
  "booksFilterUnfinished": "Unfinished",
  "@booksFilterUnfinished": {
    "description": "Chip narrowing the hub to the books not listened to the end."
  },
  "booksFinished": "Finished",
  "@booksFinished": {
    "description": "Said under a book's cover, and in the line under its title, when it has been heard to the end."
  },
  "booksLoadError": "Could not load your books",
  "@booksLoadError": {
    "description": "Title of the error state when the audiobooks could not be read."
  },
  "booksMore": "More",
  "@booksMore": {
    "description": "Accessible name of the audiobook hub's overflow menu."
  },
  "booksNothingMatches": "Nothing matches",
  "@booksNothingMatches": {
    "description": "Empty state where the chips left no book standing, which is different from an empty library."
  },
  "booksShowAll": "Show all books",
  "@booksShowAll": {
    "description": "Button clearing the finished filter from the empty state it produced."
  },
  "booksSortRow": "{sort, select, recent{Sort by recently added} title{Sort by title} author{Sort by author} other{Sort by {sort}}}",
  "@booksSortRow": {
    "description": "Row in the hub overflow choosing what order the books are in.",
    "placeholders": {
      "sort": {
        "type": "String",
        "example": "recent"
      }
    }
  },
  "booksTimeLeft": "{time} left",
  "@booksTimeLeft": {
    "description": "How much of a book is unheard, under its cover. {time} arrives already worded as a span.",
    "placeholders": {
      "time": {
        "type": "String",
        "example": "6 hr"
      }
    }
  },
  "booksTitle": "Audiobooks",
  "@booksTitle": {
    "description": "The audiobook domain's front door, named on its own title."
  }
}
