  "bookFieldEdition": "Edition",
  "@bookFieldEdition": {
    "description": "Which edition of a book this is."
  },
  "bookFieldFiles": "Files",
  "@bookFieldFiles": {
    "description": "How many files a book is made of."
  },
  "bookFieldIsbn": "ISBN",
  "@bookFieldIsbn": {
    "description": "A book's ISBN. The standard's name, the same everywhere."
  },
  "bookFieldPublisher": "Publisher",
  "@bookFieldPublisher": {
    "description": "Who published an edition of a book."
  },
  "bookLoadError": "Could not load this book",
  "@bookLoadError": {
    "description": "Title of the error state when one book could not be read."
  },
  "bookMarkFinished": "Mark finished",
  "@bookMarkFinished": {
    "description": "Row in a book's overflow recording it as heard to the end."
