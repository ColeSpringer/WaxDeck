    "description": "Message when paging further into a rule's failing items failed. Scrolling again retries, which is why it says so."
  },
  "healthLossless": "lossless",
  "@healthLossless": {
    "description": "Says a copy is stored without losing anything to compression. Lower case: it sits in a comma-separated run of a copy's properties."
  },
  "healthMergeAction": "Merge",
  "@healthMergeAction": {
    "description": "Confirming button of the merge dialog."
  },
  "healthMergeBody": "{losers} will merge into \"{survivor}\". Their items move under the survivor, and the merge cannot be undone.",
  "@healthMergeBody": {
    "description": "Body of the merge dialog. {losers} is a comma-separated run of quoted names and {survivor} the name they merge into.",
    "placeholders": {
      "losers": {
        "type": "String",
        "example": "\"The Beatles\", \"Beatles, The\""
      },
      "survivor": {
        "type": "String",
        "example": "The Beatles"
      }
    }
  },
  "healthMergeInto": "Merge into {name}",
  "@healthMergeInto": {
    "description": "Accessible name of the button that merges one duplicate group. {name} is the entity that survives.",
    "placeholders": {
      "name": {
        "type": "String",
        "example": "The Beatles"
      }
    }
  },
  "healthMergeTitle": "Merge duplicates?",
  "@healthMergeTitle": {
    "description": "Title of the dialog confirming that duplicate entities are merged into one."
  },
  "healthMergeWord": "merge",
  "@healthMergeWord": {
    "description": "The word typed to confirm a merge. Lower case here, unlike the destructive confirmations elsewhere, because a merge is recoverable work rather than a deletion. It is compared against what was typed, so translating it changes what has to be typed."
