    "description": "Kind of a duplicate finding about two albums. Lower case: it fills a small chip."
  },
  "healthEntityArtist": "artist",
  "@healthEntityArtist": {
    "description": "Kind of a duplicate finding about two artists. Lower case: it fills a small chip."
