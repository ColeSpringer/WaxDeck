  "@healthKbps": {
    "description": "One copy's bitrate, in a comma-separated run of its properties. kbps is the unit.",
    "placeholders": {
      "kbps": {
        "type": "int",
        "example": "320"
      }
    }
  },
  "healthKeepBest": "Keep the best version",
  "@healthKeepBest": {
    "description": "Accessible name of the button that resolves one quality finding."
