    "description": "Title of the error state when the file diagnostics could not be read."
  },
  "healthDiagnosticsMore": "{count} shown; there are more",
  "@healthDiagnosticsMore": {
    "description": "Caption under the diagnostics table when the list is longer than what has been fetched.",
    "placeholders": {
      "count": {
        "type": "int",
        "example": "100"
      }
    }
  },
