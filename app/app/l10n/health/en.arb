  "healthCorruptAudio": "Corrupt audio",
  "@healthCorruptAudio": {
    "description": "Name of the health rule `corrupt-audio`, which counts files whose audio will not decode."
  },
  "healthDiagnosticsChip": "{code} ({count})",
  "@healthDiagnosticsChip": {
    "description": "One diagnostic code and how many files carry it, on a filter chip. {code} is a wire token and is not translated.",
    "placeholders": {
      "code": {
        "type": "String",
        "example": "corrupt_audio"
      },
      "count": {
        "type": "int",
        "example": "12"
      }
    }
  },
  "healthDiagnosticsEmptyMessage": "Every file the catalog has seen decoded cleanly.",
  "@healthDiagnosticsEmptyMessage": {
    "description": "Empty state of the diagnostics table."
  },
