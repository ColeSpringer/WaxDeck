  "@healthEvaluatedOf": {
    "description": "Line under the warming-up headline, saying how far the first sweep has got.",
    "placeholders": {
      "checked": {
        "type": "int",
        "example": "1200"
      },
      "total": {
        "type": "int",
        "example": "1500"
      }
    }
  },
  "healthFixRule": "Fix {rule}",
  "@healthFixRule": {
    "description": "Accessible name of the button that runs a health rule's bulk fix. {rule} is that rule's own name.",
    "placeholders": {
      "rule": {
        "type": "String",
        "example": "Missing cover art"
      }
    }
  },
  "healthGenreWhitelist": "Genre outside the canonical tree",
