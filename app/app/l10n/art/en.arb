{
  "@@locale": "en",
  "@@x-template": "en.arb",
  "artSlotBack": "Back cover",
  "@artSlotBack": {
    "description": "The reverse of the sleeve."
  },
  "artSlotBackInline": "back cover",
  "@artSlotBackInline": {
    "description": "The back cover named inside a sentence. See the note on the front cover's inline form."
  },
  "artSlotBackground": "Background",
  "@artSlotBackground": {
    "description": "A wide image, and an artist portrait."
  },
  "artSlotBackgroundInline": "background",
  "@artSlotBackgroundInline": {
    "description": "The background image named inside a sentence. See the note on the front cover's inline form."
  },
  "artSlotBooklet": "Booklet",
  "@artSlotBooklet": {
    "description": "A page from the insert."
  },
  "artSlotBookletInline": "booklet",
  "@artSlotBookletInline": {
    "description": "The booklet page named inside a sentence. See the note on the front cover's inline form."
  },
  "artSlotDisc": "Disc",
  "@artSlotDisc": {
    "description": "The label printed on the disc itself."
  },
  "artSlotDiscInline": "disc",
  "@artSlotDiscInline": {
    "description": "The disc image named inside a sentence. See the note on the front cover's inline form."
  },
  "artSlotFront": "Front cover",
  "@artSlotFront": {
    "description": "The image everything else falls back to."
  },
  "artSlotFrontInline": "front cover",
  "@artSlotFrontInline": {
    "description": "The front cover named inside a sentence. English lower-cases it; a language needing an article or a different case writes that here, because the sentences around it cannot know the gender of the words in this list."
  },
  "artSourceBorrowedProvider": "From {provider}, for a track",
  "@artSourceBorrowedProvider": {
    "description": "Source mark under a cover a release borrowed from a member track whose picture a named metadata provider fetched. One sentence: the borrowed marks replaced a two-sentence join that read as two captions glued together.",
    "placeholders": {
      "provider": {
        "type": "String",
        "example": "Cover Art Archive"
      }
    }
  },
  "artSourceBorrowedProviderUnnamed": "From a metadata provider, for a track",
  "@artSourceBorrowedProviderUnnamed": {
    "description": "The borrowed provider mark for a fetched cover whose provider went unrecorded."
  },
  "artSourceBorrowedSidecar": "Art from an image beside a track",
  "@artSourceBorrowedSidecar": {
    "description": "Source mark under a cover a release borrowed from a member track's folder image."
  },
  "artSourceBorrowedTag": "Art from a track's file",
  "@artSourceBorrowedTag": {
    "description": "Source mark under a cover a release borrowed from a member track's embedded tags - the common borrowed case: the release holds no durable cover of its own, so the resolve answered with a track's."
  },
  "artSourceBorrowedUser": "Set by hand on a track",
  "@artSourceBorrowedUser": {
    "description": "Source mark under a cover a release borrowed from a member track somebody gave a cover by hand."
  },
  "artSourceFeed": "From the feed",
  "@artSourceFeed": {
    "description": "Source mark under a cover a podcast feed supplied, or one a radio station announced in its own stream."
  },
  "artSourceFromFile": "From the file",
  "@artSourceFromFile": {
    "description": "Provenance of an artifact read out of the audio file's own tags, on the rows that already name the artifact (\"Artwork · {source}\", \"Lyrics · {source}\"). Bare on purpose: the standalone artSourceTag would stutter behind the Artwork prefix and call a lyric a picture behind the Lyrics one."
  },
  "artSourceGenerated": "Made by the server",
  "@artSourceGenerated": {
    "description": "Source mark under a picture the server composed from what the catalog already holds, rather than one anybody chose. A playlist's mosaic of its members' covers is the case it exists for."
  },
  "artSourceLyricsSidecar": "From an .lrc file",
  "@artSourceLyricsSidecar": {
    "description": "Provenance of lyrics that came from a companion file beside the audio. The artwork wording (a folder image) is wrong for lyrics, which arrive as an .lrc."
  },
  "artSourceProvider": "From {provider}",
  "@artSourceProvider": {
    "description": "Source mark under a cover a metadata provider supplied. {provider} is the service's own name, which is a proper noun and stays as written.",
    "placeholders": {
      "provider": {
        "type": "String",
        "example": "Cover Art Archive"
      }
    }
  },
  "artSourceProviderUnnamed": "From a metadata provider",
  "@artSourceProviderUnnamed": {
    "description": "Source mark under a fetched cover whose provider the server did not name."
  },
  "artSourceSidecar": "From a folder image",
  "@artSourceSidecar": {
    "description": "Source mark under a cover read from an image file sitting beside the audio, such as a cover.jpg."
  },
  "artSourceTag": "Art from the file",
  "@artSourceTag": {
    "description": "Source mark under a cover read out of the audio file itself (its embedded tags). Says what the mark is about, not the mechanism: \"from the file's tags\" read as nonsense under a picture. The provenance rows, already prefixed with the artifact's name, draw the bare artSourceFromFile instead."
  },
  "artSourceUser": "Set by hand",
  "@artSourceUser": {
    "description": "Source mark under a cover somebody chose through the curation surface."
  },
  "artworkClearAction": "Clear",
  "@artworkClearAction": {
    "description": "Confirming button of the clear-artwork dialog. It removes stored content rather than emptying a list, which some languages word differently."
  },
  "artworkClearBody": "The slot becomes empty. Nothing falls back into it.",
  "@artworkClearBody": {
    "description": "Body of the clear dialog for every slot but the front cover."
  },
  "artworkClearFrontBody": "The item falls back to its album or artist cover. The image itself is removed from the catalog.",
  "@artworkClearFrontBody": {
    "description": "Body of the clear dialog for the front cover, which is the one slot that falls back to something else."
  },
  "artworkClearSlot": "Clear the {slot}",
  "@artworkClearSlot": {
    "description": "Accessible name of the control that empties one artwork slot. {slot} is the slot's inline form.",
    "placeholders": {
      "slot": {
        "type": "String",
        "example": "front cover"
      }
    }
  },
  "artworkClearTitle": "Clear the {slot}?",
  "@artworkClearTitle": {
    "description": "Title of the dialog confirming that one artwork slot is emptied. {slot} is the slot's inline form, which carries the article this language needs.",
    "placeholders": {
      "slot": {
        "type": "String",
        "example": "front cover"
      }
    }
  },
  "artworkClearWord": "clear",
  "@artworkClearWord": {
    "description": "The word typed to confirm emptying an artwork slot. Lower case, and compared against what was typed, so translating it changes what has to be typed."
  },
  "artworkCleared": "{slot} cleared",
  "@artworkCleared": {
    "description": "Message after one artwork slot was emptied. {slot} is the slot's name.",
    "placeholders": {
      "slot": {
        "type": "String",
        "example": "Front cover"
      }
    }
  },
  "artworkDropHint": "Drop an image into {slot}",
  "@artworkDropHint": {
    "description": "Hint drawn over one artwork slot when a file is dragged onto it. {slot} is the slot's inline form.",
    "placeholders": {
      "slot": {
        "type": "String",
        "example": "front cover"
      }
    }
  },
  "artworkLockHelp": "Keeps this cover through scans and enrichment runs, and holds the other slots against automatic fills too. Pinned with the slot empty means \"leave this without one\" rather than \"nothing was found\", which is the state that otherwise refuses every cover with no explanation.",
  "@artworkLockHelp": {
    "description": "Help under the cover pin switch. The second sentence is the whole reason the pin is visible: a cleared-and-pinned cover refuses every later write."
  },
  "artworkLockPinned": "Cover pinned",
  "@artworkLockPinned": {
    "description": "Confirmation after pinning a cover."
  },
  "artworkLockTitle": "Pin this cover",
  "@artworkLockTitle": {
    "description": "Switch over an album or artist cover: keep the picture through scans and enrichment runs."
  },
  "artworkLockUnpinned": "Cover unpinned",
  "@artworkLockUnpinned": {
    "description": "Confirmation after unpinning a cover."
  },
  "artworkOneImageOnly": "{slot} takes one image; using {file}",
  "@artworkOneImageOnly": {
    "description": "Message after several images were dropped on one slot. {slot} is the slot's name and {file} the one that was taken.",
    "placeholders": {
      "slot": {
        "type": "String",
        "example": "Front cover"
      },
      "file": {
        "type": "String",
        "example": "cover.jpg"
      }
    }
  },
  "artworkOverline": "One image per slot",
  "@artworkOverline": {
    "description": "Line above the Artwork heading. A slot is one named place an image can go."
  },
  "artworkPickLabel": "Image",
  "@artworkPickLabel": {
    "description": "What the file picker calls the image it is asking for."
  },
  "artworkPinSlot": "Pin {slot}",
  "@artworkPinSlot": {
    "description": "Toggle over one auxiliary artwork slot: hold the picture through scans and enrichment runs. {slot} is the slot's inline form.",
    "placeholders": {
      "slot": {
        "type": "String",
        "example": "the disc art"
      }
    }
  },
  "artworkReplaceSlot": "Replace the {slot}",
  "@artworkReplaceSlot": {
    "description": "Accessible name of the control that replaces a filled artwork slot. {slot} is the slot's inline form.",
    "placeholders": {
      "slot": {
        "type": "String",
        "example": "front cover"
      }
    }
  },
  "artworkReplaced": "{slot} replaced",
  "@artworkReplaced": {
    "description": "Message after one artwork slot was filled. {slot} is the slot's name.",
    "placeholders": {
      "slot": {
        "type": "String",
        "example": "Front cover"
      }
    }
  },
  "artworkSetSlot": "Set the {slot}",
  "@artworkSetSlot": {
    "description": "Accessible name of the control that fills an empty artwork slot. {slot} is the slot's inline form.",
    "placeholders": {
      "slot": {
        "type": "String",
        "example": "front cover"
      }
    }
  },
  "artworkSlotPinned": "{slot} pinned",
  "@artworkSlotPinned": {
    "description": "Confirmation after pinning one auxiliary artwork slot. {slot} is the slot's name.",
    "placeholders": {
      "slot": {
        "type": "String",
        "example": "Disc art"
      }
    }
  },
  "artworkSlotSpoken": "{slot}: {state}",
  "@artworkSlotSpoken": {
    "description": "One artwork tile read as a whole: the slot's name, then what is in it.",
    "placeholders": {
      "slot": {
        "type": "String",
        "example": "Front cover"
      },
      "state": {
        "type": "String",
        "example": "jpeg, 1000 x 1000"
      }
    }
  },
  "artworkSlotUnpinned": "{slot} unpinned",
  "@artworkSlotUnpinned": {
    "description": "Confirmation after unpinning one auxiliary artwork slot. {slot} is the slot's name.",
    "placeholders": {
      "slot": {
        "type": "String",
        "example": "Disc art"
      }
    }
  },
  "artworkSlotsUnreadable": "Could not read which slots this item holds; what is drawn below may be inherited.",
  "@artworkSlotsUnreadable": {
    "description": "Caution over the artwork grid when the slot listing failed. Inherited means the image belongs to the album or artist rather than to this item."
  },
  "artworkStateEmpty": "Empty",
  "@artworkStateEmpty": {
    "description": "Says an artwork slot holds nothing. Agrees with the word for a slot in this language."
  },
  "artworkStateImage": "image",
  "@artworkStateImage": {
    "description": "Stands in for an image's format when the server did not say what it is. Lower case: it leads a comma-separated run of facts about the image."
  },
  "artworkStateInherited": "Inherited",
  "@artworkStateInherited": {
    "description": "Says a slot draws the album's or artist's image rather than one of its own. Agrees with the word for an image in this language."
  },
  "artworkStatePinned": "Pinned, no image",
  "@artworkStatePinned": {
    "description": "Says an artwork slot is pinned with nothing in it: the cover was cleared and the pin left standing, which means do not refill this rather than no cover yet."
  },
  "artworkStateSize": "{width} x {height}",
  "@artworkStateSize": {
    "description": "An image's pixel size, in a comma-separated run of facts about it.",
    "placeholders": {
      "width": {
        "type": "int",
        "example": "1000"
      },
      "height": {
        "type": "int",
        "example": "1000"
      }
    }
  },
  "artworkStateSizeUnknown": "Size unknown",
  "@artworkStateSizeUnknown": {
    "description": "Stands where an artwork tile normally reads its pixel size, for a cover the server stored but never measured - an exotic container it has no decoder for. Distinguishes \"the server does not know\" from \"nobody asked\"."
  },
  "artworkTitle": "Artwork",
  "@artworkTitle": {
    "description": "Heading over an item's images."
  },
  "artworkTooLarge": "{file} is larger than the 16 MB an image may be",
  "@artworkTooLarge": {
    "description": "Refusal for an image over the endpoint's ceiling. The ceiling is fixed at 16 megabytes.",
    "placeholders": {
      "file": {
        "type": "String",
        "example": "scan.png"
      }
    }
  },
  "artworkUnpinSlot": "Unpin {slot}",
  "@artworkUnpinSlot": {
    "description": "Toggle over one auxiliary artwork slot that is already pinned. {slot} is the slot's inline form.",
    "placeholders": {
      "slot": {
        "type": "String",
        "example": "the disc art"
      }
    }
  },
  "artworkUnreadable": "{file} could not be read",
  "@artworkUnreadable": {
    "description": "Refusal for a picked image whose bytes could not be opened.",
    "placeholders": {
      "file": {
        "type": "String",
        "example": "cover.jpg"
      }
    }
  }
}
