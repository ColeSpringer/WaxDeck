  "@uploadsFileTypeAudio": {
    "description": "What the file picker calls the group of audio formats it accepts."
  },
  "uploadsFileUnreadable": "The file could not be read",
  "@uploadsFileUnreadable": {
    "description": "The reason slot of uploadsFileFailed when the picked file itself stopped answering (moved, unmounted, or shrunk between pick and transfer) rather than the server refusing it."
  },
  "uploadsFinishing": "Finishing",
  "@uploadsFinishing": {
    "description": "Under an upload row once every byte has arrived and the server is sealing the session."
  },
  "uploadsFinishingUnreachable": "Finishing, can't reach the server",
  "@uploadsFinishingUnreachable": {
    "description": "Under an upload row in place of uploadsFinishing while asking the server how its seal went fails on the network; the row keeps asking and goes back to Finishing at the first answer."
  },
  "uploadsFormat": "Download format",
  "@uploadsFormat": {
    "description": "Accessible name of the picker choosing what a URL download is converted to."
