{
  "@@locale": "en",
  "@@x-template": "en.arb",
  "uploadsAcquireQueued": "Downloading; appears in review when ready",
  "@uploadsAcquireQueued": {
    "description": "Snackbar after asking the server to download from a URL."
  },
  "uploadsAcquireTasks": "Tasks",
  "@uploadsAcquireTasks": {
    "description": "Action on the downloading snackbar, opening the background-task screen."
  },
  "uploadsAddTitle": "Add to the library",
  "@uploadsAddTitle": {
    "description": "Heading of the sheet offering the ways audio gets in."
  },
  "uploadsBatch": "{count, plural, =1{Uploaded together, 1 file} other{Uploaded together, {count} files}}",
  "@uploadsBatch": {
    "description": "Header over the files of one batch upload.",
    "placeholders": {
      "count": {
        "type": "int",
        "example": "12"
      }
    }
  },
  "uploadsDiscardBody": "\"{fileName}\" is removed and its quota space freed.",
  "@uploadsDiscardBody": {
    "description": "Body of the discard confirmation. {fileName} is the file's own name.",
    "placeholders": {
      "fileName": {
        "type": "String",
        "example": "01 - Nightswimming.flac"
      }
    }
  },
  "uploadsDiscardConfirm": "Discard",
  "@uploadsDiscardConfirm": {
    "description": "Confirming button of the discard dialog."
  },
  "uploadsDiscardRow": "Discard upload",
  "@uploadsDiscardRow": {
    "description": "Accessible name of the control that throws one staged upload away."
  },
  "uploadsDiscardTitle": "Discard upload?",
  "@uploadsDiscardTitle": {
    "description": "Title of the typed confirmation before a staged upload is thrown away."
  },
  "uploadsDiscardWord": "discard",
  "@uploadsDiscardWord": {
    "description": "The word somebody types to confirm a discard. Lower case, one word, and what the field is checked against - keep it short and easy to type."
  },
  "uploadsDownload": "Download",
  "@uploadsDownload": {
    "description": "Confirming button of the add-from-URL dialog."
  },
  "uploadsDropHint": "Drop audio files to upload",
  "@uploadsDropHint": {
    "description": "Overlay caption while audio is dragged over a page-sized drop zone, on Home and on the uploads screen."
  },
  "uploadsDuplicate": "Duplicate ({kind}): {what}",
  "@uploadsDuplicate": {
    "description": "Banner on an upload the server matched against something already in the library. {kind} says how it matched; {what} names what it matched.",
    "placeholders": {
      "kind": {
        "type": "String",
        "example": "exact copy"
      },
      "what": {
        "type": "String",
        "example": "Nightswimming by Field Notes"
      }
    }
  },
  "uploadsDuplicateBy": "{title} by {artist}",
  "@uploadsDuplicateBy": {
    "description": "What a duplicate matched, where the match names an artist.",
    "placeholders": {
      "title": {
        "type": "String",
        "example": "Nightswimming"
      },
      "artist": {
        "type": "String",
        "example": "Field Notes"
      }
    }
  },
  "uploadsDuplicateContent": "exact copy",
  "@uploadsDuplicateContent": {
    "description": "How a duplicate matched: the bytes are the same file. Lower case: it sits in brackets inside a sentence."
  },
  "uploadsDuplicateFingerprint": "same recording",
  "@uploadsDuplicateFingerprint": {
    "description": "How a duplicate matched: a different file of the same audio. Lower case: it sits in brackets."
  },
  "uploadsDuplicateId": "same identifier",
  "@uploadsDuplicateId": {
    "description": "How a duplicate matched: the file's tags carry the same MusicBrainz recording id as an item in the library. Lower case: it sits in brackets."
  },
  "uploadsDuplicateJoined": "Already in the library: {what}",
  "@uploadsDuplicateJoined": {
    "description": "Note on an imported upload whose audio the library already held: the file was added to that item as a copy (or nothing was added), and the item kept its details. {what} names the item.",
    "placeholders": {
      "what": {
        "type": "String",
        "example": "Hell Shell by Dom Kennedy"
      }
    }
  },
  "uploadsDuplicateName": "name match",
  "@uploadsDuplicateName": {
    "description": "How a duplicate matched: only the name is the same. Lower case: it sits in brackets."
  },
  "uploadsDuplicateUnseen": "an item in a library you cannot open",
  "@uploadsDuplicateUnseen": {
    "description": "What a duplicate matched when it sits in a library the uploader cannot see, so its title is not theirs to read."
  },
  "uploadsEmptyTitle": "No uploads yet",
  "@uploadsEmptyTitle": {
    "description": "Empty state of the uploads screen."
  },
  "uploadsFileEmpty": "The file is empty",
  "@uploadsFileEmpty": {
    "description": "Why a picked file was not uploaded: it holds no bytes. Shown as {reason} in uploadsFileFailed."
  },
  "uploadsFileFailed": "{name}: {reason}",
  "@uploadsFileFailed": {
    "description": "One file's failure inside a multi-file upload, which keeps going: the file's own name and the worded reason.",
    "placeholders": {
      "name": {
        "type": "String",
        "example": "01 Teardrop.flac"
      },
      "reason": {
        "type": "String",
        "example": "You are out of space."
      }
    }
  },
  "uploadsFileOverQuota": "Larger than your whole upload limit of {limit}, so clearing Past uploads cannot make room. An administrator can raise the limit.",
  "@uploadsFileOverQuota": {
    "description": "Why a picked or shared file was not uploaded: the file alone is larger than the uploader's whole allowance (`quota-exceeded`), so importing or discarding staged sessions cannot admit it. Shown as {reason} in uploadsFileFailed. 'Past uploads' is the uploads screen's list of sessions.",
    "placeholders": {
      "limit": {
        "type": "String",
        "example": "500 MB"
      }
    }
  },
  "uploadsFileTypeAny": "All files",
  "@uploadsFileTypeAny": {
    "description": "What the file picker calls the group that accepts anything, which is what keeps a file in a custom accepted-format set reachable."
  },
