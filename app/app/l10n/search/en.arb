    "description": "Snackbar confirming a subscription made from a directory result. {name} is the show's own name.",
    "placeholders": {
      "name": {
        "type": "String",
        "example": "Song Exploder"
      }
    }
  },
  "searchTitle": "Search",
  "@searchTitle": {
    "description": "Title of the search screen."
  },
  "searchTopResult": "Top result",
  "@searchTopResult": {
    "description": "Heading over the one artist or album whose name is the search, shown above the result groups."
  },
  "searchTruncated": "More matches exist; refine your search",
  "@searchTruncated": {
    "description": "Note under the results when the server capped how many it answered with."
  },
  "searchYourStations": "Your stations",
  "@searchYourStations": {
    "description": "Heading over the radio stations this server already has."
