{
  "@@locale": "en",
  "@@x-template": "en.arb",
  "searchAction": "Search",
  "@searchAction": {
    "description": "App-bar button that opens the search screen. A verb."
  },
  "searchAddStation": "Add station",
  "@searchAddStation": {
    "description": "Button on a directory result that adds that station to this server."
  },
  "searchDirectoryDegraded": "Directory unreachable; add a station by URL in Radio",
