  },
  "bellSurfaceBackups": "Backups",
  "@bellSurfaceBackups": {
    "description": "Which surface a bell row is about."
  },
  "bellSurfaceDownloads": "Downloads",
  "@bellSurfaceDownloads": {
    "description": "Which surface a bell row is about."
  },
  "bellSurfaceImports": "Imports",
  "@bellSurfaceImports": {
    "description": "Which surface a bell row is about."
  },
  "bellSurfacePlaylists": "Playlists",
  "@bellSurfacePlaylists": {
    "description": "Overline on bell rows about playlists."
  },
  "bellSurfacePodcasts": "Podcasts",
  "@bellSurfacePodcasts": {
    "description": "Which surface a bell row is about."
  },
  "bellSurfaceReview": "Review queue",
  "@bellSurfaceReview": {
    "description": "Which surface a bell row is about."
  },
  "bellSurfaceTasks": "Background tasks",
  "@bellSurfaceTasks": {
    "description": "Which surface a bell row is about."
  },
  "bellSurfaceUploads": "Uploads",
  "@bellSurfaceUploads": {
    "description": "Which surface a bell row is about."
  },
  "bellTaskChanged": "A background task changed.",
  "@bellTaskChanged": {
    "description": "What a bell row says. Generic because the marker carries no detail."
  },
  "bellTitle": "Notifications",
  "@bellTitle": {
    "description": "The word for notifications: the accessible name of the bell in the top app bar with nothing unread, and the title of the screen that holds the same list."
  },
  "bellUnread": "{count, plural, =1{Notifications, 1 unread} other{Notifications, {count} unread}}",
  "@bellUnread": {
    "description": "Accessible name of the bell when rows have arrived since it was last opened.",
    "placeholders": {
      "count": {
        "type": "int",
        "example": "3"
      }
    }
  },
  "bellUnreadOverline": "Unread",
  "@bellUnreadOverline": {
    "description": "Overline on a notification row nobody has dealt with yet. Words rather than colour alone, so the state reads out."
  },
  "bellUploadChanged": "An upload changed.",
  "@bellUploadChanged": {
    "description": "What a bell row says. Generic because the marker carries no detail."
  }
