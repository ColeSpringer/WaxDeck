{
  "@@locale": "en",
  "@@x-template": "en.arb",
  "bellActivityBlurb": "What happened to this account, newest first. This device's own transfers are listed only while the app is open.",
  "@bellActivityBlurb": {
    "description": "Line under the activity heading on the notifications screen, saying plainly that the list is this session's."
  },
  "bellActivityTitle": "Recent activity",
  "@bellActivityTitle": {
    "description": "Heading over the list of what happened while the app was open."
  },
  "bellClear": "Clear",
  "@bellClear": {
    "description": "Empties the list: the last row of the open bell, and the action on the notifications screen."
  },
  "bellClearConfirm": "Delete every notification for this account, on every device? This cannot be undone.",
  "@bellClearConfirm": {
    "description": "Body of the confirmation before emptying the notification inbox, which is durable and shared across the account's devices."
  },
  "bellClearTitle": "Empty notifications",
  "@bellClearTitle": {
    "description": "Title of the confirmation before emptying the notification inbox."
  },
  "bellDelete": "Delete",
  "@bellDelete": {
    "description": "Removes one row from the inbox for good; the per-row action on the notifications screen."
  },
  "bellDownloadFinished": "A download finished.",
  "@bellDownloadFinished": {
    "description": "What a bell row says when this device finished keeping something offline."
  },
  "bellEmpty": "Nothing has happened yet.",
  "@bellEmpty": {
    "description": "Drawn in the open bell and under the notifications screen's own heading when this session has seen nothing. Empty is a legitimate state, not a broken bell."
  },
  "bellEmptyTitle": "Nothing to report",
  "@bellEmptyTitle": {
    "description": "Heading of the empty state on the notifications screen. The bell's own menu needs no heading, so it draws the message alone."
  },
  "bellEpisodeDownloaded": "A new episode finished downloading.",
  "@bellEpisodeDownloaded": {
    "description": "What a bell row says when a subscribed show gained an episode on this server."
  },
  "bellFeedDisabled": "A show kept failing to refresh and was disabled.",
  "@bellFeedDisabled": {
    "description": "What a bell row says when a subscribed feed was switched off."
  },
  "bellImportCompleted": "An upload was added to the library.",
  "@bellImportCompleted": {
    "description": "What a bell row says when an upload was filed. Deliberately not identified: the same marker covers the path where nothing was matched."
  },
  "bellMarkAllRead": "Mark all read",
  "@bellMarkAllRead": {
    "description": "Stamps every unread row read, which is what clears the bell's badge without opening anything."
  },
  "bellNothingNew": "Nothing new.",
  "@bellNothingNew": {
    "description": "Drawn in the open bell when nothing is waiting to be dealt with. The screen still lists what happened; this says only that none of it is outstanding."
  },
  "bellPlaylistSynced": "A synced playlist changed, or its syncing was suspended",
  "@bellPlaylistSynced": {
    "description": "Bell row for the playlist-synced marker: a background sync run changed the playlist, or repeated failures suspended its schedule. The row opens the playlist."
  },
  "bellReadOverline": "Read",
  "@bellReadOverline": {
    "description": "Overline on a notification row somebody has already dealt with."
  },
  "bellReviewChanged": "The review queue changed.",
  "@bellReviewChanged": {
    "description": "What a bell row says. Generic because the marker it comes from carries no detail; the surface it opens has it."
  },
  "bellRow": "{surface}: {what}",
  "@bellRow": {
    "description": "One row of the bell: which surface moved, then what happened there.",
    "placeholders": {
      "surface": {
        "type": "String",
        "example": "Uploads"
      },
      "what": {
        "type": "String",
        "example": "An upload changed."
      }
    }
  },
  "bellRowWhen": "{surface} · {when}",
  "@bellRowWhen": {
    "description": "The line under a row on the notifications screen: which surface moved, then how long ago.",
    "placeholders": {
      "surface": {
        "type": "String",
        "example": "Uploads"
      },
      "when": {
        "type": "String",
        "example": "12 min ago"
      }
    }
  },
  "bellSurfaceAccounts": "Accounts",
  "@bellSurfaceAccounts": {
