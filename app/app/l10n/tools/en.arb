{
  "@@locale": "en",
  "@@x-template": "en.arb",
  "toolsClearFinished": "Clear finished",
  "@toolsClearFinished": {
    "description": "Button that removes every finished task from the list at once."
  },
  "toolsCountAdded": "added {count}",
  "@toolsCountAdded": {
    "description": "Counter in a finished scan's result: files that brought new items. Lower case: it sits in a comma-separated run of counters.",
    "placeholders": {
      "count": {
        "type": "int",
        "example": "12"
      }
    }
  },
  "toolsCountAnalyzed": "analyzed {count}",
  "@toolsCountAnalyzed": {
    "description": "Counter in a finished analysis's result: files fingerprinted. Lower case: it sits in a comma-separated run of counters.",
    "placeholders": {
      "count": {
        "type": "int",
        "example": "120"
      }
    }
  },
  "toolsCountCovers": "covers {count}",
  "@toolsCountCovers": {
    "description": "Counter in a finished enrichment's result: front covers it fetched. Lower case: it sits in a comma-separated run of counters.",
    "placeholders": {
      "count": {
        "type": "int",
        "example": "6"
      }
    }
  },
  "toolsCountErrored": "errored {count}",
  "@toolsCountErrored": {
    "description": "Counter in a finished job's result: files it could not read or write. Lower case: it sits in a comma-separated run of counters.",
    "placeholders": {
      "count": {
        "type": "int",
        "example": "0"
      }
    }
  },
  "toolsCountFailed": "failed {count}",
  "@toolsCountFailed": {
    "description": "Counter in a finished fix's result: items it could not fix. Lower case: it sits in a comma-separated run of counters.",
    "placeholders": {
      "count": {
        "type": "int",
        "example": "0"
      }
    }
  },
  "toolsCountFilledOf": "filled {filled} of {attempted}",
  "@toolsCountFilledOf": {
    "description": "Counter in a finished health fix's result: how many of the items it tried it fixed. Lower case: it sits in a comma-separated run of counters.",
    "placeholders": {
      "filled": {
        "type": "int",
        "example": "3"
      },
      "attempted": {
        "type": "int",
        "example": "5"
      }
    }
  },
  "toolsCountLyrics": "lyrics {count}",
  "@toolsCountLyrics": {
    "description": "Counter in a finished enrichment's result: tracks some source answered lyrics for. Lower case: it sits in a comma-separated run of counters.",
    "placeholders": {
      "count": {
        "type": "int",
        "example": "40"
      }
    }
  },
  "toolsCountMissing": "missing {count}",
  "@toolsCountMissing": {
    "description": "Counter in a finished scan's result: items whose files are gone from disk. Lower case: it sits in a comma-separated run of counters.",
    "placeholders": {
      "count": {
        "type": "int",
        "example": "1"
      }
    }
  },
  "toolsCountMoved": "moved {count}",
  "@toolsCountMoved": {
    "description": "Counter in a finished organize run's result: files moved into place. Lower case: it sits in a comma-separated run of counters.",
    "placeholders": {
      "count": {
        "type": "int",
        "example": "30"
      }
    }
  },
  "toolsCountPictures": "pictures {count}",
  "@toolsCountPictures": {
    "description": "Counter in a finished enrichment's result: other pictures it fetched, backs and booklets. Lower case: it sits in a comma-separated run of counters.",
    "placeholders": {
      "count": {
        "type": "int",
        "example": "2"
      }
    }
  },
  "toolsCountSkipped": "skipped {count}",
  "@toolsCountSkipped": {
    "description": "Counter in a finished job's or fix's result: items left alone. Lower case: it sits in a comma-separated run of counters.",
    "placeholders": {
      "count": {
        "type": "int",
        "example": "2"
      }
    }
  },
  "toolsCountUpdated": "updated {count}",
  "@toolsCountUpdated": {
    "description": "Counter in a finished scan's result: files whose audio changed. Lower case: it sits in a comma-separated run of counters.",
    "placeholders": {
      "count": {
        "type": "int",
        "example": "3"
      }
    }
  },
  "toolsDismiss": "Dismiss",
  "@toolsDismiss": {
    "description": "Accessible name of the control that removes one finished task from the list."
  },
  "toolsEmptyMessage": "Merges, splits, downloads, and imports report their progress here while they run and land here when they finish.",
  "@toolsEmptyMessage": {
    "description": "Empty state of the tool task list, naming what turns up in it."
  },
  "toolsEmptyTitle": "No tool tasks",
  "@toolsEmptyTitle": {
    "description": "Empty state of the tool task list."
  },
  "toolsFinishedTapForReport": "Finished · tap for the report",
  "@toolsFinishedTapForReport": {
    "description": "Line under a finished task that produced no items but stored a report."
  },
  "toolsItemsProduced": "{count} items produced · tap to open",
  "@toolsItemsProduced": {
    "description": "Line under a finished task that produced several items. It is never drawn for one, which has a line of its own.",
    "placeholders": {
      "count": {
        "type": "int",
        "example": "4"
      }
    }
  },
  "toolsJobAnalyze": "Audio analysis",
  "@toolsJobAnalyze": {
    "description": "Name of a catalog job that fingerprints files and measures their loudness."
  },
  "toolsJobDelete": "Delete",
  "@toolsJobDelete": {
    "description": "Name of a catalog job that deletes files from the library."
  },
  "toolsJobEmptyTrash": "Emptying the trash",
  "@toolsJobEmptyTrash": {
    "description": "Name of a catalog job that permanently deletes the trashed files."
  },
  "toolsJobEnrich": "Enrichment",
  "@toolsJobEnrich": {
    "description": "Name of a catalog job that looks up artwork, lyrics and metadata."
  },
  "toolsJobImport": "Import",
  "@toolsJobImport": {
    "description": "Name of a catalog job that files one uploaded or downloaded file into the library."
  },
  "toolsJobOrganize": "Organize",
  "@toolsJobOrganize": {
    "description": "Name of a catalog job that moves files into the library's layout."
  },
  "toolsJobPurgeTrash": "Purge from the trash",
  "@toolsJobPurgeTrash": {
    "description": "Name of a catalog job that permanently deletes one trashed file."
  },
  "toolsJobRestore": "Restore",
  "@toolsJobRestore": {
    "description": "Name of a catalog job that restores files from the trash."
  },
  "toolsJobScan": "Library scan",
  "@toolsJobScan": {
    "description": "Name of a catalog job that scans the library folders."
  },
  "toolsJobsTitle": "Library jobs",
  "@toolsJobsTitle": {
    "description": "Heading over the catalog's own jobs (scans, enrichment, analysis) on the tasks screen, shown to administrators."
  },
  "toolsLoadError": "Could not load tool tasks",
  "@toolsLoadError": {
    "description": "Title of the error state when the task list could not be read."
  },
  "toolsOpenReviewQueue": "Open the review queue",
  "@toolsOpenReviewQueue": {
    "description": "Line under a finished download, whose results wait in the review queue."
  },
  "toolsProduced": "produced {pids}",
  "@toolsProduced": {
    "description": "Names what a task produced, on the row's identifier line. {pids} is a comma-separated run of item identifiers and is not translated.",
    "placeholders": {
      "pids": {
        "type": "String",
        "example": "al-01JZX5N8QW, al-01JZX5N8QX"
      }
    }
  },
  "toolsReadyForReview": "{count, plural, =1{1 ready for review} other{{count} ready for review}}",
  "@toolsReadyForReview": {
    "description": "Line under a finished download, counting what it left in the review queue.",
    "placeholders": {
      "count": {
        "type": "int",
        "example": "3"
      }
    }
  },
  "toolsStateCanceled": "Canceled",
  "@toolsStateCanceled": {
    "description": "State of a job an administrator canceled. Agrees with the word for a task in this language."
  },
  "toolsStateCrashed": "Crashed",
  "@toolsStateCrashed": {
    "description": "State of a job the server stopped in the middle of, a restart or a crash. Agrees with the word for a task in this language."
  },
  "toolsStateDone": "Done",
  "@toolsStateDone": {
    "description": "State of a task that finished. Agrees with the word for a task in this language."
  },
  "toolsStateFailed": "Failed",
  "@toolsStateFailed": {
    "description": "State of a task that did not finish. Agrees with the word for a task in this language."
  },
  "toolsStateQueued": "Queued",
  "@toolsStateQueued": {
    "description": "State of a task waiting its turn."
  },
  "toolsStateRunning": "Running",
  "@toolsStateRunning": {
    "description": "State of a task in flight, when it reports no percentage."
  },
  "toolsStateRunningPct": "Running · {percent}%",
  "@toolsStateRunningPct": {
    "description": "State of a task in flight that reports how far along it is.",
    "placeholders": {
      "percent": {
        "type": "int",
        "example": "42"
      }
    }
  },
  "toolsSummaryListens": "listens {count}",
  "@toolsSummaryListens": {
    "description": "Headline counter from a task's report, counting listening records it carried across. Lower case: it sits in a comma-separated run of counters.",
    "placeholders": {
      "count": {
        "type": "String",
        "example": "3204"
      }
    }
  },
  "toolsSummaryMatched": "matched {count}",
  "@toolsSummaryMatched": {
    "description": "Headline counter from a task's report. Lower case: it sits in a comma-separated run of counters.",
    "placeholders": {
      "count": {
        "type": "String",
        "example": "412"
      }
    }
  },
  "toolsSummaryRefused": "refused {count}",
  "@toolsSummaryRefused": {
    "description": "Headline counter from an import's report, counting plays the server would not record: the account being imported onto is not allowed the item (it is in a library that account cannot see, or a content rule hides it), or the source described the play in a way no listening record can be made from. Distinct from unmatched, which is the catalog not holding the recording at all. Lower case: it sits in a comma-separated run of counters.",
    "placeholders": {
      "count": {
        "type": "String",
        "example": "84"
      }
    }
  },
  "toolsSummaryTruncated": "oldest history not read",
  "@toolsSummaryTruncated": {
    "description": "Headline note on an import whose history ran past what one run reads: the most recent part landed. Lower case: it sits in a comma-separated run of counters."
  },
  "toolsSummaryUnmatched": "unmatched {count}",
  "@toolsSummaryUnmatched": {
    "description": "Headline counter from a task's report. Lower case: it sits in a comma-separated run of counters.",
    "placeholders": {
      "count": {
        "type": "String",
        "example": "18"
      }
    }
  },
  "toolsTapForReport": "Tap for the report",
  "@toolsTapForReport": {
    "description": "Line under a failed task that still stored a report worth reading."
  },
  "toolsTapToOpenResult": "Tap to open what it produced",
  "@toolsTapToOpenResult": {
    "description": "Line under a finished task that produced exactly one item."
  },
  "toolsTaskAcquire": "URL download",
  "@toolsTaskAcquire": {
    "description": "Name of the task that fetches audio from a web address."
  },
  "toolsTaskBookMerge": "Book merge",
  "@toolsTaskBookMerge": {
    "description": "Name of the task that joins several audiobook files into one book."
  },
  "toolsTaskBookSplit": "Book split",
  "@toolsTaskBookSplit": {
    "description": "Name of the task that breaks one audiobook into its parts."
  },
  "toolsTaskCueSplit": "CUE split",
  "@toolsTaskCueSplit": {
    "description": "Name of the task that cuts one long audio file into tracks using its CUE sheet. CUE is a file format and stays as it is."
  },
  "toolsTaskGenreNormalize": "Genre clean-up",
  "@toolsTaskGenreNormalize": {
    "description": "Name of a task that folds genre spellings onto the canonical genre tree."
  },
  "toolsTaskHealthFix": "Fix: {rule}",
  "@toolsTaskHealthFix": {
    "description": "Name of a task fixing one library health rule. {rule} is the rule's own name.",
    "placeholders": {
      "rule": {
        "type": "String",
        "example": "Missing lyrics"
      }
    }
  },
  "toolsTaskImportFrom": "Import from {source}",
  "@toolsTaskImportFrom": {
    "description": "Name of the task that copies stars, ratings, history, and progress out of another server. {source} is that server's product name and is not translated. A task's name is a noun, unlike the playlist import dialog's title of the same English.",
    "placeholders": {
      "source": {
        "type": "String",
        "example": "Navidrome"
      }
    }
  },
  "toolsTaskPlaylistSync": "Playlist sync",
  "@toolsTaskPlaylistSync": {
    "description": "Name of the task that reconciles a playlist bound to an external source: enumerate, download what is new, and update membership."
  },
  "toolsTasksCleared": "{count, plural, =1{Cleared 1 task} other{Cleared {count} tasks}}",
  "@toolsTasksCleared": {
    "description": "Message after finished tasks were swept, saying how many went.",
    "placeholders": {
      "count": {
        "type": "int",
        "example": "7"
      }
    }
  },
  "toolsTasksSection": "Tool tasks",
  "@toolsTasksSection": {
    "description": "Heading over the tool tasks list when the catalog's jobs are listed above it."
  },
  "toolsTitle": "Tool tasks",
  "@toolsTitle": {
    "description": "Title of the screen following long-running library work: merges, splits, downloads, imports."
  }
}
