<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>com.apple.security.app-sandbox</key>
	<true/>
	<!-- Reaching the server at all. Absent, the sandbox refuses every
	     request and the packaged app cannot sign in. -->
	<key>com.apple.security.network.client</key>
	<true/>
	<!-- OIDC in app mode returns through a loopback listener this app
	     binds itself, which the sandbox counts as being a server. -->
	<key>com.apple.security.network.server</key>
	<true/>
	<!-- No keychain-access-groups here on purpose. It is a restricted
	     entitlement: its presence makes the build demand a development
	     certificate, and these artifacts are deliberately unsigned
	     (see releasing.md). It also buys nothing yet - the plugin only
	     sets kSecAttrAccessGroup when a groupId is passed, and
	     SecureCredentialStore passes none, so the default access group
	     applies. It belongs with the signing work, not before it. -->
</dict>
</plist>
